# agenthand environment — copy to .env or set in your MCP client's env block.

# Required for the live tools (identify, cut_out, draw): your Meta Model
# API key. The evidence verbs and the conformance replay need no key.
META_API_KEY=

# Optional: where agenthand keeps its assets, ledger and receipts.
# AGENTHAND_DATA_DIR=

# Optional: draw plate default when a call does not say
# (generated | source_edit).
# AGENTHAND_DRAW_PLATE=

# Optional: local Marketplace comps file for the pricing block.
# AGENTHAND_COMPS_FILE=

# Room-run narration (Muse Spark Open on Baseten) takes its credential
# from the host's credential helper; there is no env var for it. Without
# a helper, the narration step records a clear error and returns no
# transcript. The three core tools above do not use it.
